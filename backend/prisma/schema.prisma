// ---------------------------------------------------------------------
// BON DE RÉCEPTION FOURNISSEUR (Étape 1 module Bordereau Fournisseur)
// Règle métier : 1 bon de réception = 1 lot = 1 bordereau.
// ---------------------------------------------------------------------

model SupplierReception {
  id                 String    @id @default(cuid())
  reference          String    @unique // BR-000001
  ean13              String?   @unique // code-barres EAN13 (préfixe 3)
  date               DateTime  @default(now())
  heure              String?
  supplierId         String
  productId          String
  nbrColis           Decimal   @db.Decimal(14, 3)
  poidsEmballageVide Decimal   @default(0) @db.Decimal(14, 3) // kg
  avanceOui          Boolean   @default(false)
  avanceMontant      Decimal   @default(0) @db.Decimal(14, 2)
  droitMarche        Decimal   @default(0) @db.Decimal(14, 2) // frais droit de marché (DA) imputé au bordereau
  transport          Decimal   @default(0) @db.Decimal(14, 2) // frais transport (DA) imputé au bordereau
  observations       String?
  bordereauId        String?
  lotId              String?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([supplierId])
  @@index([productId])
  @@index([deletedAt])
}

model SupplierBordereau {
  id                    String    @id @default(cuid())
  reference             String    @unique // BF-000001
  ean13                 String?   @unique // code-barres EAN13 (préfixe 4)
  supplierId            String
  productId             String
  receptionId           String
  lotId                 String
  calibre               String? // calibre optionnel (Option B : bordereau lié à fournisseur+produit+calibre)
  colisRecus            Decimal   @db.Decimal(14, 3)
  colisVendus           Decimal   @default(0) @db.Decimal(14, 3)
  colisRestant          Decimal   @db.Decimal(14, 3)
  poidsNetVendu         Decimal   @default(0) @db.Decimal(14, 3)
  totalBrutVentes       Decimal   @default(0) @db.Decimal(14, 2)
  commissionType        String    @default("pourcentage") // 'pourcentage' | 'fixe'
  commissionValue       Decimal   @default(0) @db.Decimal(14, 2)
  avancesAffectees      Decimal   @default(0) @db.Decimal(14, 2)
  droitMarche           Decimal   @default(0) @db.Decimal(14, 2) // frais droit de marché (DA) imputé/déduit
  transport             Decimal   @default(0) @db.Decimal(14, 2) // frais transport (DA) imputé/déduit
  montantFinalDu        Decimal   @default(0) @db.Decimal(14, 2)
  statut                String    @default("ouvert") // ouvert|pret_a_cloturer|cloture|partiellement_paye|paye|annule
  dateOuverture         DateTime  @default(now())
  dateCloture           DateTime?
  clotureParUserId      String?
  commissionDefinitive  Decimal?  @db.Decimal(14, 2)
  avancesDefinitives    Decimal?  @db.Decimal(14, 2)
  montantFinalDefinitif Decimal?  @db.Decimal(14, 2)
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  paymentLines SupplierPaymentLine[]

  @@index([supplierId])
  @@index([productId])
  @@index([deletedAt])
}

// Ligne calibre d'une réception multi-calibres (1 ligne = 1 lot).
model SupplierReceptionItem {
  id                 String    @id @default(cuid())
  receptionId        String
  calibre            String?
  nbrColis           Decimal   @db.Decimal(14, 3)
  poidsEmballageVide Decimal   @default(0) @db.Decimal(14, 3)
  lotId              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([receptionId])
  @@index([lotId])
}

// Opération corrective sur bordereau clôturé (Étape 4)
model SupplierBordereauCorrection {
  id             String   @id @default(cuid())
  bordereauId    String
  userId         String
  date           DateTime @default(now())
  motif          String
  champ          String?
  ancienneValeur String
  nouvelleValeur String
  createdAt      DateTime @default(now())

  @@index([bordereauId])
}

// =====================================================================
// MODULE CAISSE (Temps 1) — journée de caisse, entrées/sorties, dépenses,
// approvisionnements, remises, clôtures et journal d'audit.
// Règle métier : l'argent est TOUJOURS en Decimal(14,2). Soft-delete via deletedAt
// sur les entités de saisie. Les factures/paiements sont lus en LECTURE SEULE
// (agrégés à la volée) et ne génèrent JAMAIS de CashRegisterEntry.
// =====================================================================

/// Une journée de caisse (1 ligne par date). Les champs de totaux sont des
/// "miroirs" recalculés à chaque mutation pour la performance ; la source de
/// vérité reste les modules Factures/Paiements + les CashRegisterEntry.
model CashRegisterDay {
  id                        String    @id @default(cuid())
  date                      DateTime  @unique // la journée (minuit local)
  openingCashFund           Decimal   @default(0) @db.Decimal(14, 2) // ancien fonds de caisse
  invoiceTotal              Decimal   @default(0) @db.Decimal(14, 2) // total factures du jour
  creditCollectionTotal     Decimal   @default(0) @db.Decimal(14, 2) // encaissements de crédits clients
  cashSupplyTotal           Decimal   @default(0) @db.Decimal(14, 2) // approvisionnements caisse
  totalEntries              Decimal   @default(0) @db.Decimal(14, 2) // total des entrées
  creditInvoiceTotal        Decimal   @default(0) @db.Decimal(14, 2) // factures à crédit (non encaissées)
  unpaidPartialInvoiceTotal Decimal   @default(0) @db.Decimal(14, 2) // reliquat des factures partiellement payées
  expenseTotal              Decimal   @default(0) @db.Decimal(14, 2) // total dépenses
  cashRemittanceTotal       Decimal   @default(0) @db.Decimal(14, 2) // total remises
  closingCashFund           Decimal   @default(0) @db.Decimal(14, 2) // nouveau fonds de caisse
  totalOutputs              Decimal   @default(0) @db.Decimal(14, 2) // total des sorties
  difference                Decimal   @default(0) @db.Decimal(14, 2) // écart entrées - sorties
  status                    String    @default("ouverte") // ouverte|à_vérifier|cloturee|reouverte
  closedBy                  String?
  closedAt                  DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  entries  CashRegisterEntry[]
  closings CashRegisterClosing[]

  @@index([deletedAt])
  @@index([date])
  @@index([status])
}

/// Ligne de caisse (entrée ou sortie). SEULES les saisies manuelles
/// (dépense, approvisionnement, remise, fonds de clôture) créent une ligne.
model CashRegisterEntry {
  id                String          @id @default(cuid())
  cashRegisterDayId String
  day               CashRegisterDay @relation(fields: [cashRegisterDayId], references: [id])
  direction         String // ENTRY|OUTPUT
  category          String // libellé de catégorie (FR)
  amount            Decimal         @db.Decimal(14, 2)
  sourceType        String // INVOICE_TOTAL|CREDIT_COLLECTION|EXPENSE|CASH_SUPPLY|REMITTANCE|CLOSING_FUND|OPENING_FUND|OTHER_ENTRY|OTHER_OUTPUT
  sourceId          String?
  reference         String?
  description       String?
  createdBy         String?
  createdAt         DateTime        @default(now())
  deletedAt         DateTime?

  @@unique([sourceType, sourceId]) // anti-doublon strict
  @@index([cashRegisterDayId])
  @@index([deletedAt])
  @@index([direction])
}

/// Dépense de caisse. Annulation = status 'annulee' + ligne de caisse inverse
/// (jamais de suppression physique).
model Expense {
  id            String        @id @default(cuid())
  date          DateTime
  heure         String?
  motif         String
  category      String?
  type          String        @default("depense") // 'depense' | 'entree'
  amount        Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod @default(CASH)
  observation   String?
  justificatif  String?
  userId        String?
  status        String        @default("validee") // validee|annulee
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([date])
  @@index([status])
  @@index([deletedAt])
}

/// Approvisionnement de la caisse (entrée d'argent hors ventes).
model CashSupply {
  id           String    @id @default(cuid())
  reference    String    @unique
  date         DateTime
  heure        String?
  amount       Decimal   @db.Decimal(14, 2)
  motif        String
  mode         String
  userId       String?
  observation  String?
  justificatif String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([date])
  @@index([deletedAt])
}

/// Remise d'espèces (sortie de caisse vers banque/direction).
model CashRemittance {
  id           String    @id @default(cuid())
  reference    String    @unique
  date         DateTime
  heure        String?
  amount       Decimal   @db.Decimal(14, 2)
  beneficiary  String?
  motif        String
  userId       String?
  observation  String?
  justificatif String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([date])
  @@index([deletedAt])
}

/// Instantané figé d'une clôture de journée (traçabilité comptable).
model CashRegisterClosing {
  id                 String          @id @default(cuid())
  cashRegisterDayId  String
  day                CashRegisterDay @relation(fields: [cashRegisterDayId], references: [id])
  closedBy           String?
  closedAt           DateTime        @default(now())
  ancienFonds        Decimal         @db.Decimal(14, 2)
  facturesTotal      Decimal         @db.Decimal(14, 2)
  encaissementsTotal Decimal         @db.Decimal(14, 2)
  approTotal         Decimal         @db.Decimal(14, 2)
  depensesTotal      Decimal         @db.Decimal(14, 2)
  creditsCreesTotal  Decimal         @db.Decimal(14, 2)
  nonEncaisseTotal   Decimal         @db.Decimal(14, 2)
  remisesTotal       Decimal         @db.Decimal(14, 2)
  nouveauFonds       Decimal         @db.Decimal(14, 2)
  totalEntrees       Decimal         @db.Decimal(14, 2)
  totalSorties       Decimal         @db.Decimal(14, 2)
  difference         Decimal         @db.Decimal(14, 2)
  createdAt          DateTime        @default(now())

  @@index([cashRegisterDayId])
}

/// Journal d'audit spécifique au module caisse.
model CashRegisterAuditLog {
  id                String   @id @default(cuid())
  cashRegisterDayId String?
  action            String // creation|modification|annulation|cloture|reouverture|correction|changement_fonds
  userId            String?
  details           Json?
  createdAt         DateTime @default(now())

  @@index([cashRegisterDayId])
  @@index([action])
}
