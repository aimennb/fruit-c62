# =====================================================================
# Fruiterie ERP - Backend environment configuration (EXAMPLE)
# Copier en .env et renseigner les valeurs reelles (generees via openssl).
# =====================================================================

# --- Base de donnees PostgreSQL --------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://fruiterie:CHANGE_ME@localhost:5432/fruiterie"

# --- Serveur ---------------------------------------------------------
# Port d'ecoute du backend (verif navigateur: http://localhost:8080)
PORT=8080

# Origine CORS autorisee pour le frontend (separateur virgule si plusieurs)
# En Phase A: '*' pour le dev local. En prod: l'URL du front.
CORS_ORIGIN="*"

# --- Authentification (JWT) ------------------------------------------
# Secret du token d'acces (court, ~15 min). Generateur: openssl rand -base64 48
JWT_SECRET="CHANGE_ME_ACCESS"

# Secret du token de rafraichissement (long, rotation, cookie httpOnly).
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH"

# Durees (string compatibles jsonwebtoken, ex: 15m, 7d)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Securite --------------------------------------------------------
# Nombre de rounds bcrypt pour le hachage des mots de passe (10 = defaut raisonnable)
BCRYPT_ROUNDS=10

# --- Environnement ---------------------------------------------------
NODE_ENV="development"
